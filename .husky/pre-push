#!/usr/bin/env sh
# Before every push, re-runs this repo's own fetch-*.sh scripts for every
# git-tracked generated/vendored artifact (see docs/generated-files.md). If a
# fetch produces a change not yet committed, this auto-commits just that
# refresh under a distinct bot identity (so `git log`/`git blame` clearly
# show it as a mechanical refresh, not a hand-edit) and still blocks this
# push so you get a chance to look before it goes out.
#
# Each fetch step "fails open": if the script itself can't run (no network,
# no Docker, no Homebrew, upstream API hiccup), that check is skipped with a
# warning rather than blocking the push - only a *successful* fetch that
# actually differs from what's committed blocks. `git push --no-verify`
# always remains available as an explicit escape hatch.
#
# This does real downloads (jdtls + spring-boot-language-server vendor
# tarballs are 50-80MB each) and can start Docker for the models snapshot -
# expect this to take a while and to need network + Docker + Homebrew. Each
# fetch is capped at $TIMEOUT_SECS via run_with_timeout() below (no `timeout`
# binary on stock macOS, so this uses python3 - already a dependency of
# every fetch-*.sh script here) so one slow/stalled upstream host can't turn
# a push into a 20+ minute wait; a timeout is just another "couldn't
# refresh" outcome and fails open like any other fetch error.

set -u

BOT_NAME="sync-bot"
BOT_EMAIL="sync-bot@localhost"
BODY="Auto-committed by .husky/pre-push; see docs/generated-files.md."
TIMEOUT_SECS=150

refreshed=""
warned=""

run_with_timeout() {
  limit="$1"
  shift
  python3 -c '
import os, signal, subprocess, sys
limit = int(sys.argv[1])
p = subprocess.Popen(sys.argv[2:], start_new_session=True)
try:
    p.wait(timeout=limit)
except subprocess.TimeoutExpired:
    os.killpg(p.pid, signal.SIGTERM)
    try:
        p.wait(timeout=5)
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL)
    sys.exit(124)
sys.exit(p.returncode)
' "$limit" "$@"
}

check() {
  path="$1"
  script="$2"
  label="$3"
  subject="$4"

  status=0
  run_with_timeout "$TIMEOUT_SECS" "$script" >/tmp/husky-pre-push-fetch.log 2>&1 || status=$?
  if [ "$status" = 124 ]; then
    echo "pre-push: could not refresh $label ($script exceeded ${TIMEOUT_SECS}s) - skipping this check, not blocking push." >&2
    warned="1"
    return
  elif [ "$status" != 0 ]; then
    echo "pre-push: could not refresh $label ($script failed) - skipping this check, not blocking push." >&2
    sed 's/^/  /' /tmp/husky-pre-push-fetch.log >&2
    warned="1"
    return
  fi

  if git diff --quiet -- "$path" && [ -z "$(git status --porcelain -- "$path")" ]; then
    return
  fi

  git add -f -- "$path"
  if GIT_AUTHOR_NAME="$BOT_NAME" GIT_AUTHOR_EMAIL="$BOT_EMAIL" \
     GIT_COMMITTER_NAME="$BOT_NAME" GIT_COMMITTER_EMAIL="$BOT_EMAIL" \
     git commit -q -m "$subject" -m "$BODY" -- "$path"
  then
    sha=$(git rev-parse --short HEAD)
    echo "pre-push: $label was stale - auto-committed refresh as $sha ($subject)" >&2
  else
    echo "pre-push: $label drifted but auto-commit failed - fix manually." >&2
  fi
  refreshed="$refreshed $label"
}

check "docs/opencode-docs-reference/" "docs/fetch-opencode-docs.sh" "opencode docs mirror" "chore(docs): refresh opencode docs mirror from upstream"
check "deploy/models-dev-snapshot.json" "deploy/fetch-models-snapshot.sh" "models.dev snapshot" "chore(deploy): refresh models.dev snapshot"
check "mcp-servers/java-lsp/vendor/" "mcp-servers/java-lsp/fetch-jdtls.sh" "jdtls vendor package" "chore(java-lsp): refresh vendored jdtls"
check "mcp-servers/spring-lsp/vendor/" "mcp-servers/spring-lsp/fetch-spring-boot-language-server.sh" "spring-boot-language-server vendor package" "chore(spring-lsp): refresh vendored spring-boot-language-server"

rm -f /tmp/husky-pre-push-fetch.log

if [ -n "$refreshed" ]; then
  echo "" >&2
  echo "pre-push: blocked -$refreshed drifted from upstream and got auto-committed under '$BOT_NAME'." >&2
  echo "Review with 'git show', then push again. Use 'git push --no-verify' to bypass." >&2
  exit 1
fi

if [ -n "$warned" ]; then
  echo "pre-push: some freshness checks were skipped above (see warnings) - push allowed." >&2
fi

exit 0
