# Absolute path to the Java project jdtls should analyze.
JAVA_LSP_WORKSPACE_ROOT=/path/to/your/java/project

# jdtls's own workspace/index storage directory (its `-data` flag) - NOT
# the project root above. Use a directory dedicated to this one project;
# jdtls refuses to share a -data dir across concurrently-running instances
# for different projects. Doesn't need to exist beforehand.
JDTLS_DATA_DIR=/path/to/a/scratch/dir/jdtls-data

# The jdtls launcher command. Defaults to the vendored jdtls this package
# ships (vendor/jdt-language-server-*.tar.gz, auto-extracted on first run -
# see README.md's Vendoring section) - needs python3 on PATH, nothing else
# to install. Override with an absolute path to use a different jdtls
# instead (e.g. from `brew install jdtls`).
#JDTLS_COMMAND=/path/to/some/other/jdtls

# Optional. jdtls itself needs a JDK 21+ runtime to launch (whatever
# JAVA_HOME the JDTLS_COMMAND wrapper picks up) - that's a separate concern
# from which JDK your actual project should be compiled/analyzed against.
# Set this to point jdtls at a *different* JDK for the project itself (its
# own --java-executable flag) if your project targets an older Java version
# than whatever launches jdtls. See README.md's "JDK version" section.
#JAVA_EXECUTABLE=/path/to/jdk8/bin/java

# Port the HTTP MCP server listens on (optional, defaults to 8092 - the
# next free port after mcp-servers/loki's 8091).
JAVA_LSP_MCP_PORT=8092
