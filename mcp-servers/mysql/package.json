    "directory": "mcp-servers/mysql"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test mysql.test.ts"
  },
  "dependencies": {
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
