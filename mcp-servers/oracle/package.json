{
  "name": "@kealthas-dev/opencode-mcp-oracle",
  "version": "0.0.0",
  "type": "module",
  "description": "Read-only SQL query server for Oracle (a local HTTP /query route) and its `opencode-oracle-query` command-line client - see README.md for the connection design and the config.json-driven config",
  "main": "dist/server.js",
  "bin": {
    "opencode-oracle-query": "dist/cli.js",
    "opencode-mcp-oracle": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Keal-thas/opencode-toolkit.git",
    "directory": "mcp-servers/oracle"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test oracle.test.ts"
  },
  "dependencies": {
    "oracledb": "^6.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/oracledb": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
