{
  "name": "@kealthas-dev/opencode-mcp-oracle",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server exposing a single passthrough oracle_query tool - see README.md for the connection/audit design and the config.json-driven config",
  "main": "dist/server.js",
  "bin": {
    "opencode-mcp-oracle": "dist/server.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Keal-thas/opencode-toolkit.git",
    "directory": "mcp-servers/oracle"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test oracle.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "oracledb": "^6.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/oracledb": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
