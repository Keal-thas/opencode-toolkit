{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "review_verdict": "deny"
  },
  "agent": {
    "build": {
      "prompt": "{file:./system-prompt.txt}"
    },
    "plan": {
      "prompt": "{file:./system-prompt.txt}"
    },
    "general": {
      "prompt": "{file:./system-prompt.txt}"
    },
    "verifier": {
      "description": "Independent, read-only reviewer. Use it after a non-trivial change to check the work. Give it the user's original request verbatim and what to check; it reads the diff itself.",
      "mode": "subagent",
      "prompt": "{file:./verifier-prompt.txt}",
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git status --short": "allow",
          "git diff": "allow",
          "git diff --stat": "allow",
          "git diff HEAD": "allow",
          "git diff origin/master...HEAD": "allow",
          "git diff origin/main...HEAD": "allow",
          "git diff master...HEAD": "allow",
          "git diff main...HEAD": "allow",
          "git log --oneline origin/master..HEAD": "allow",
          "git log --oneline origin/main..HEAD": "allow",
          "git log --oneline": "allow",
          "git log --oneline -10": "allow",
          "git merge-base HEAD origin/master": "allow",
          "git merge-base HEAD origin/main": "allow"
        }
      }
    },
    "review-gate": {
      "description": "Internal ALLOW/BLOCK safety reviewer used by the llm-review-gate plugin. Not user-facing.",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "todowrite": "deny",
        "skill": "deny",
        "review_verdict": "allow"
      }
    }
  },
  "plugin": [
    "@kealthas-dev/opencode-gitbash-edit-path-fix"
    // Opt-in: logs every hook event as JSONL under ~/opencode-hook-output/, also how SETUP.md checks the system prompt actually sent.
    // "@kealthas-dev/opencode-hook-logger"
    // Opt-in: adds a hidden model call before every bash command and blocks it when the review fails. Uncomment (and add a comma after the entry above) to enable, see SETUP.md step 5.
    // "@kealthas-dev/opencode-llm-review-gate"
    // Opt-in guard plugins: enable after validating against this machine's model, see SETUP.md step 5.
    // "@kealthas-dev/opencode-loop-guard"
    // "@kealthas-dev/opencode-path-guard"
  ],
  "mcp": {
    "java-lsp": {
      "type": "remote",
      "url": "http://localhost:8092/mcp",
      "enabled": true
    },
    "spring-lsp": {
      "type": "remote",
      "url": "http://localhost:8093/mcp",
      "enabled": true
    },
    "idea": {
      "type": "remote",
      "url": "REPLACE_WITH_URL_FROM_IDEA_SETTINGS_TOOLS_MCP_SERVER_COPY_HTTP_STREAM_CONFIG",
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": ["mcp-server-memory"],
      "enabled": true
    }
  }
}
