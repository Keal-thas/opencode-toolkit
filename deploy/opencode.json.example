{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "review_verdict": "deny"
  },
  "agent": {
    "build": {
      "prompt": "{file:./system-prompt.txt}"
    },
    "plan": {
      "prompt": "{file:./system-prompt.txt}"
    },
    "general": {
      "prompt": "{file:./system-prompt.txt}"
    },
    "review-gate": {
      "description": "Internal ALLOW/BLOCK safety reviewer used by the llm-review-gate plugin. Not user-facing.",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "todowrite": "deny",
        "skill": "deny",
        "review_verdict": "allow"
      }
    }
  },
  "plugin": [
    "@kealthas-dev/opencode-system-prompt-tools",
    "@kealthas-dev/opencode-hook-logger",
    "@kealthas-dev/opencode-llm-review-gate"
  ],
  "mcp": {
    "oracle": {
      "type": "remote",
      "url": "http://localhost:8090/mcp",
      "enabled": true
    },
    "loki": {
      "type": "remote",
      "url": "http://localhost:8091/mcp",
      "enabled": true
    },
    "java-lsp": {
      "type": "remote",
      "url": "http://localhost:8092/mcp",
      "enabled": true
    },
    "spring-lsp": {
      "type": "remote",
      "url": "http://localhost:8093/mcp",
      "enabled": true
    },
    "mysql": {
      "type": "remote",
      "url": "http://localhost:8094/mcp",
      "enabled": true
    },
    "idea": {
      "type": "remote",
      "url": "REPLACE_WITH_URL_FROM_IDEA_SETTINGS_TOOLS_MCP_SERVER_COPY_HTTP_STREAM_CONFIG",
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": ["mcp-server-memory"],
      "enabled": true
    },
    "redis": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "redis-mcp-server@latest",
        "redis-mcp-server",
        "--host",
        "REPLACE_WITH_REDIS_HOST",
        "--port",
        "REPLACE_WITH_REDIS_PORT"
      ],
      "enabled": true,
      "environment": {
        "REDIS_USERNAME": "REPLACE_WITH_REDIS_READONLY_USERNAME",
        "REDIS_PWD": "REPLACE_WITH_REDIS_READONLY_PASSWORD"
      }
    }
  }
}
