.claude/
*.log
.DS_Store
Thumbs.db
node_modules/

# Scratch/handoff notes, local experiment output, etc. - never meant to be
# committed, kept out of the repo root so they don't show up as stray
# untracked files.
.local/
.idea/

# Real credentials for the mcp-servers/*/ servers (Loki/java-lsp/spring-lsp
# connection strings, users, passwords) - unlike docker/.env these hold live
# secrets, not pinned non-secret version data, so they're never committed.
# Each server's .env.example documents the shape without real values.
# mcp-servers/oracle/ is the exception: its real config lives entirely
# outside this repo, under $HOME/.config/kealthas-dev/opencode-mcp-oracle/
# (see mcp-servers/oracle/README.md's Configuration section), so there's
# nothing repo-local to ignore for it here.
mcp-servers/**/.env

# TypeScript build output - mcp-servers/oracle/ is the one package in this
# repo compiled via tsc rather than run/published as plain JS or loaded as
# raw .ts (see CLAUDE.md's mcp-servers/ row); dist/ is generated by `npm run
# build` there, not hand-authored, so it isn't committed.
mcp-servers/oracle/dist/

# The extracted spring-boot-language-server (jar + ~170 lib/ jars, ~85MB
# uncompressed) - mcp-servers/spring-lsp/server.js extracts vendor/*.tar.gz into
# this directory lazily on first run (see resolveLanguageServerDir() in
# server.js). Only the tar.gz itself is committed.
mcp-servers/spring-lsp/vendor/spring-boot-language-server-*/

# Same pattern for the vendored jdtls (see resolveJdtlsCommand() in
# mcp-servers/java-lsp/server.js). Only the tar.gz itself is committed.
mcp-servers/java-lsp/vendor/jdt-language-server-*/

# Still git-tracked and committed normally (see docs/fetch-opencode-docs.sh) -
# this entry doesn't untrack anything. It only makes ripgrep-based tools
# (grep/glob in both Claude Code and opencode itself) skip this directory
# during broad recursive search, since these mirrored doc pages are long and
# were getting swept into unrelated searches. An explicit path (reading a
# specific file, or `rg pattern docs/opencode-docs-reference/`) still works -
# only recursive discovery is filtered. New pages added by the fetch script
# need `git add -f` since gitignored paths aren't auto-picked-up as untracked.
docs/opencode-docs-reference/

# Same reasoning as docs/opencode-docs-reference/ above - still git-tracked
# and committed normally (see deploy/fetch-models-snapshot.sh), this entry
# doesn't untrack it. It's a generated data dump (opencode's models.dev
# catalog), not hand-authored content, so it's excluded from broad
# recursive search the same way. Re-add with `git add -f` after refreshing.
deploy/models-dev-snapshot.json
